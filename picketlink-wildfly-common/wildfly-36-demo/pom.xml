<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.picketlink</groupId>
    <artifactId>picketlink-bindings-parent</artifactId>
    <version>3.0.6</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <artifactId>picketlink-wildfly36-demo</artifactId>
  <packaging>pom</packaging>
  <name>PicketLink WildFly 36 SP/IDP Demo</name>
  <description>Dual WildFly demo with Angular SPAs, CXF REST APIs, and SAML SSO</description>

  <modules>
    <module>demo-shared</module>
    <module>demo-sp-war</module>
    <module>demo-idp-war</module>
    <module>demo-it</module>
  </modules>

  <properties>
    <wildfly.version>36.0.1.Final</wildfly.version>
    <cxf.version>4.0.5</cxf.version>
    <node.version>v22.12.0</node.version>
    <npm.version>10.9.2</npm.version>
    <frontend-maven-plugin.version>1.15.1</frontend-maven-plugin.version>
    <demo.idp.host>127.0.0.102</demo.idp.host>
    <demo.sp.host>127.0.0.101</demo.sp.host>
    <demo.http.port>8080</demo.http.port>
    <demo.mgmt.port>9990</demo.mgmt.port>
    <demo.keep.alive.minutes>30</demo.keep.alive.minutes>
    <demo.keep.alive>false</demo.keep.alive>
    <demo.idp.jboss.home>${project.build.directory}/wildfly-idp</demo.idp.jboss.home>
    <demo.sp.jboss.home>${project.build.directory}/wildfly-sp</demo.sp.jboss.home>
    <picketlink.test.keystore.path>${demo.idp.jboss.home}/standalone/configuration/jbid_test_keystore.jks</picketlink.test.keystore.path>
    <junit.version>4.13.2</junit.version>
    <httpcomponents.version>4.5.14</httpcomponents.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.apache.cxf</groupId>
        <artifactId>cxf-bom</artifactId>
        <version>${cxf.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <profiles>
    <profile>
      <id>demo-keep-alive</id>
      <properties>
        <demo.keep.alive>true</demo.keep.alive>
      </properties>
    </profile>
  </profiles>
</project>
