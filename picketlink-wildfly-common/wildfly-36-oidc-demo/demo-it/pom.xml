<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.picketlink</groupId>
    <artifactId>picketlink-wildfly36-oidc-demo</artifactId>
    <version>3.0.4</version>
  </parent>

  <artifactId>picketlink-demo-oidc-it</artifactId>
  <packaging>jar</packaging>
  <name>PicketLink OIDC Demo Integration Tests</name>

  <dependencies>
    <dependency>
      <groupId>org.picketlink</groupId>
      <artifactId>picketlink-oidc</artifactId>
      <version>${project.version}</version>
      <classifier>keystore-agent</classifier>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.wildfly.core</groupId>
      <artifactId>wildfly-controller-client</artifactId>
      <version>28.0.1.Final</version>
    </dependency>
    <dependency>
      <groupId>org.jboss.logging</groupId>
      <artifactId>jboss-logging</artifactId>
      <version>3.6.1.Final</version>
    </dependency>
    <dependency>
      <groupId>org.jboss</groupId>
      <artifactId>jboss-dmr</artifactId>
      <version>1.7.0.Final</version>
    </dependency>
    <dependency>
      <groupId>junit</groupId>
      <artifactId>junit</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.apache.httpcomponents</groupId>
      <artifactId>httpclient</artifactId>
      <version>${httpcomponents.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <testResources>
      <testResource>
        <directory>src/test/resources</directory>
        <filtering>true</filtering>
        <excludes>
          <exclude>**/*.jks</exclude>
        </excludes>
      </testResource>
      <testResource>
        <directory>src/test/resources</directory>
        <filtering>false</filtering>
        <includes>
          <include>**/*.jks</include>
        </includes>
      </testResource>
    </testResources>
    <plugins>
      <plugin>
        <groupId>com.googlecode.maven-download-plugin</groupId>
        <artifactId>download-maven-plugin</artifactId>
        <version>1.9.0</version>
        <executions>
          <execution>
            <id>download-wildfly-as</id>
            <phase>generate-test-resources</phase>
            <goals>
              <goal>wget</goal>
            </goals>
            <configuration>
              <url>https://github.com/wildfly/wildfly/releases/download/${wildfly.version}/wildfly-${wildfly.version}.zip</url>
              <unpack>true</unpack>
              <outputDirectory>${project.build.directory}/wildfly-as-download</outputDirectory>
              <skipCache>false</skipCache>
            </configuration>
          </execution>
          <execution>
            <id>download-wildfly-rp</id>
            <phase>generate-test-resources</phase>
            <goals>
              <goal>wget</goal>
            </goals>
            <configuration>
              <url>https://github.com/wildfly/wildfly/releases/download/${wildfly.version}/wildfly-${wildfly.version}.zip</url>
              <unpack>true</unpack>
              <outputDirectory>${project.build.directory}/wildfly-rp-download</outputDirectory>
              <skipCache>false</skipCache>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-antrun-plugin</artifactId>
        <version>3.1.0</version>
        <executions>
          <execution>
            <id>stage-wildfly-instances</id>
            <phase>process-test-resources</phase>
            <goals>
              <goal>run</goal>
            </goals>
            <configuration>
              <target>
                <delete dir="${demo.as.jboss.home}" quiet="true"/>
                <delete dir="${demo.rp.jboss.home}" quiet="true"/>
                <copy todir="${demo.as.jboss.home}">
                  <fileset dir="${project.build.directory}/wildfly-as-download/wildfly-${wildfly.version}"/>
                </copy>
                <copy todir="${demo.rp.jboss.home}">
                  <fileset dir="${project.build.directory}/wildfly-rp-download/wildfly-${wildfly.version}"/>
                </copy>
                <chmod dir="${demo.as.jboss.home}/bin" perm="ugo+rx" includes="*.sh"/>
                <chmod dir="${demo.rp.jboss.home}/bin" perm="ugo+rx" includes="*.sh"/>
              </target>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <version>3.8.1</version>
        <executions>
          <execution>
            <id>copy-oidc-keystore-agent</id>
            <phase>generate-test-resources</phase>
            <goals>
              <goal>copy</goal>
            </goals>
            <configuration>
              <artifactItems>
                <artifactItem>
                  <groupId>org.picketlink</groupId>
                  <artifactId>picketlink-oidc</artifactId>
                  <version>${project.version}</version>
                  <classifier>keystore-agent</classifier>
                  <outputDirectory>${project.build.directory}</outputDirectory>
                  <destFileName>picketlink-oidc-keystore-agent.jar</destFileName>
                </artifactItem>
              </artifactItems>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.2.5</version>
        <configuration>
          <skipTests>true</skipTests>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <version>3.2.5</version>
        <configuration>
          <systemPropertyVariables>
            <demo.keep.alive>${demo.keep.alive}</demo.keep.alive>
            <demo.as.host>${demo.as.host}</demo.as.host>
            <demo.rp.host>${demo.rp.host}</demo.rp.host>
            <demo.http.port>${demo.http.port}</demo.http.port>
            <demo.mgmt.port>${demo.mgmt.port}</demo.mgmt.port>
            <demo.as.jboss.home>${demo.as.jboss.home}</demo.as.jboss.home>
            <demo.rp.jboss.home>${demo.rp.jboss.home}</demo.rp.jboss.home>
            <demo.keep.alive.minutes>${demo.keep.alive.minutes}</demo.keep.alive.minutes>
            <picketlink.test.keystore.path>${picketlink.test.keystore.path}</picketlink.test.keystore.path>
          </systemPropertyVariables>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>integration-test</goal>
              <goal>verify</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
