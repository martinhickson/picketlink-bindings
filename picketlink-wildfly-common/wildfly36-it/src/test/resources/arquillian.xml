<?xml version="1.0" encoding="UTF-8"?>
<arquillian xmlns="http://jboss.org/schema/arquillian"
            xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
            xsi:schemaLocation="http://jboss.org/schema/arquillian http://jboss.org/schema/arquillian/arquillian_1_0.xsd">

    <defaultProtocol type="Servlet 5.0"/>

    <container qualifier="wildfly-managed" default="true">
        <configuration>
            <property name="jbossHome">${jboss.home}</property>
            <property name="allowConnectingToRunningServer">false</property>
            <property name="managementPort">10090</property>
            <property name="javaVmArguments">-Xms512m -Xmx1024m -Djboss.bind.address=127.0.0.1 -Djboss.bind.address.management=127.0.0.1 -Djboss.socket.binding.port-offset=100 -Djava.security.auth.login.config=${jboss.home}/standalone/configuration/picketlink-sp.login.conf -javaagent:${jboss.home}/modules/org/picketlink/elytron-trace/main/elytron-trace-agent.jar -Djboss.modules.system.pkgs=org.picketlink.test.wildfly36.bytebuddy -Dpicketlink.elytron.trace.file=${project.build.directory}/elytron-trace.log</property>
        </configuration>
    </container>
</arquillian>
